# Copy to .env on the server next to the lichess-bot checkout and fill in the
# real value, then lock it down:
#
#   cp deploy/.env.example ~/lichess-bot/.env
#   chmod 600 ~/lichess-bot/.env
#
# The systemd unit loads this file (EnvironmentFile) so the token never lives in
# a committed file. Keep .env out of git.

# Lichess OAuth token for the bot account (Preferences -> API access tokens).
# Overrides the token field in config.yml at startup.
LICHESS_BOT_TOKEN=
